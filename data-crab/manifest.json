{
  "manifest_version": 3,
  "name": "screen-grab-crab",
  "version": "1.2",
  "permissions": ["tabs", "activeTab", "downloads", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons":{
    "128": "icon128.png"
  }
}

