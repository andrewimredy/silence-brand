{
  "manifest_version": 3,
  "name": "silence, brand",
  "description": "extension to mute video ads",
  "version": "0.2",
  "icons": {
    "16": "crab.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://api.openai.com/",
    "download"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

